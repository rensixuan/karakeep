# deploy.py creates .env with independent random secrets; never copy production secrets into Git.
COMPOSE_PROJECT_NAME=karakeep
KARAKEEP_IMAGE=karakeep-custom:local
NEXTAUTH_URL=http://localhost:3000
WEB_BIND=127.0.0.1
WEB_PORT=3000
COMPOSE_PROFILES=
CADDY_SITE=localhost
NEXTAUTH_SECRET=GENERATED_BY_DEPLOY_SCRIPT
MEILI_MASTER_KEY=GENERATED_BY_DEPLOY_SCRIPT
TRANSLATION_ENCRYPTION_KEY=GENERATED_BY_DEPLOY_SCRIPT
DISABLE_SIGNUPS=true
DB_WAL_MODE=true
CRAWLER_NUM_WORKERS=1
CRAWLER_PARSER_MEM_LIMIT_MB=256
SEARCH_NUM_WORKERS=2
LOG_LEVEL=info
OPENAI_API_KEY=
INFERENCE_TEXT_MODEL=gpt-5.4-mini
INFERENCE_LANG="简体中文"
INFERENCE_CONTEXT_LENGTH=16384
INFERENCE_MAX_OUTPUT_TOKENS=8192
INFERENCE_USE_MAX_COMPLETION_TOKENS=true
INFERENCE_ENABLE_AUTO_TAGGING=false
INFERENCE_ENABLE_AUTO_SUMMARIZATION=false
EMBEDDING_ENABLE_AUTO_INDEXING=false
