Dockerfile
.dockerignore
**/node_modules
npm-debug.log
README.md
**/.next
**/*.db
**/.env*
.turbo
.git
./data

# Files that don't need to be included in the Docker image
.github
docs
kubernetes
charts
apps/mobile
apps/landing
apps/browser-extension
packages/e2e_tests
packages/benchmarks
tools/compare-models
tools/seed-snapshot
snapshots

# Aider
.aider*

# next.js
.next/
out/
.claude/worktrees
.playwright-cli
output

# Host-only deployment files can contain generated credentials.
deploy
# One-off local migration tooling is not part of this deployable distribution.
apps/workers/scripts/migrateReadwise.*
